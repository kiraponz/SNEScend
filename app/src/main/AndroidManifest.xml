<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rumble on the controller being played with -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Asking Gemini about the game screen (the Gemini settings) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AmetrineApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ametrine">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Its own process, killed when the game ends, so each game starts with a clean one.
             configChanges: rotation, resizing and the like must not recreate this activity,
             because the VM runs on a thread it owns. -->
        <activity
            android:name=".emulation.EmulationActivity"
            android:process=":emu"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Ametrine.Emulation" />
    </application>

</manifest>
